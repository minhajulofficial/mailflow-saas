# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encryption master key (32 bytes base64-encoded)
ENCRYPTION_MASTER_KEY=your_32_byte_base64_encryption_key

# App URL
APP_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Background jobs (Inngest)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Upstash Redis
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Internal background worker API (generate at least 32 random bytes)
WORKER_API_SECRET=replace_with_a_long_random_worker_secret

# Vercel cron secret (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
# Falls back to WORKER_API_SECRET when unset.
CRON_SECRET=replace_with_a_long_random_cron_secret

# AI
AI_API_KEY=your_anthropic_api_key

# Webhook secrets
BREVO_WEBHOOK_SECRET=your_brevo_webhook_secret
MAILJET_WEBHOOK_SECRET=your_mailjet_webhook_secret
APIFY_WEBHOOK_SECRET=your_apify_webhook_secret

# Apify actor used for Google Maps extraction
# Defaults to compass~crawler-google-places when unset.
APIFY_ACTOR_ID=compass~crawler-google-places

# Unsubscribe link signing (falls back to ENCRYPTION_MASTER_KEY when unset)
UNSUBSCRIBE_SECRET=replace_with_a_long_random_unsubscribe_secret

# Monitoring
SENTRY_DSN=your_sentry_dsn
